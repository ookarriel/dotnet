# Plantilla SIN secretos reales. Copie a .env, edite y exporte (set -a; source .env; set +a).
# ASP.NET Core usa doble guion bajo para configuración anidada.

# --- SQL Server (requerido para ejecutar la API) ---
# Linux/Docker/remoto con autenticación SQL:
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=fifo;User Id=sa;Password=REEMPLAZAR_PASSWORD_SQL;TrustServerCertificate=True

# Windows SQLEXPRESS con autenticación integrada (use esta línea en lugar de la anterior):
# ConnectionStrings__DefaultConnection=Server=.\\SQLEXPRESS;Database=fifo;Integrated Security=true;TrustServerCertificate=True

# Aplicar migraciones automáticamente al arrancar (crea la BD si no existe)
Database__ApplyMigrationsOnStartup=true

# --- JWT (mínimo 32 bytes) ---
Jwt__Key=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_BYTES
Jwt__Issuer=fifoApi
Jwt__Audience=fifoClients
Jwt__ExpirationMinutes=60

# --- Usuarios iniciales (seed; solo se crean si no existen) ---
SeedData__AdminEmail=admin@example.com
SeedData__AdminPassword=REEMPLAZAR_POR_PASSWORD_SEGURA
SeedData__UserEmail=user@example.com
SeedData__UserPassword=REEMPLAZAR_POR_OTRA_PASSWORD_SEGURA

# --- Opcional: ejecutar la suite de pruebas contra SQL Server real ---
# FIFO_TESTS_SQLSERVER=1
# FIFO_TESTS_CONNECTION=Server=localhost,1433;User Id=sa;Password=REEMPLAZAR_PASSWORD_SQL;TrustServerCertificate=True
